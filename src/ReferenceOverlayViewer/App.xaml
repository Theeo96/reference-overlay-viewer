<Application x:Class="ReferenceOverlayViewer.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <Style TargetType="Button">
   <Setter Property="Margin" Value="3,0"/><Setter Property="Padding" Value="9,5"/>
   <Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#14213A"/>
   <Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="ToggleButton">
   <Setter Property="Margin" Value="3,0"/><Setter Property="Padding" Value="10,5"/>
   <Setter Property="Background" Value="#DBEAFE"/><Setter Property="Foreground" Value="#14213A"/>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Application.Resources>
</Application>

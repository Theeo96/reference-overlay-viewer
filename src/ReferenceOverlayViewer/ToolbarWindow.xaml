<Window x:Class="ReferenceOverlayViewer.ToolbarWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="레퍼런스 이미지 뷰어" Icon="Assets/app.ico" Width="760" Height="112" MinWidth="520"
 WindowStyle="None" ResizeMode="CanMinimize" Topmost="True" Background="#14213A"
 FontFamily="Malgun Gothic" FontSize="12" Foreground="White">
 <Border BorderBrush="#40516C" BorderThickness="1" Background="#14213A">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="DragArea" Background="Transparent" MouseLeftButtonDown="DragBar">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="10,0" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
     <Image Source="Assets/app-icon.png" Width="22" Height="22" Margin="0,0,7,0"/>
     <TextBlock Text="REFERENCE  /  이미지 뷰어" FontWeight="SemiBold" FontSize="13"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="OpenButton" Content="열기" Click="OpenClick" ToolTip="PNG · JPG · BMP"/>
     <ToggleButton x:Name="EditToggle" Content="편집 모드 OFF" Click="EditClick" ToolTip="켜면 이미지 이동·확대와 창 크기 조절 가능"/>
     <Button Content="—" Click="MinimizeClick" ToolTip="최소화"/>
     <Button Content="×" Click="CloseClick" ToolTip="종료" Margin="3,0,8,0"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="6,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="불투명도" Margin="4,0"/>
     <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="75" Width="78" VerticalAlignment="Center" ValueChanged="OpacityChanged" ToolTip="본문 불투명도 0~100%"/>
     <TextBlock x:Name="OpacityLabel" Text="75%" Width="33" Margin="4,0"/>
    </StackPanel>
    <Border Grid.Column="1" Background="Transparent" MouseLeftButtonDown="DragBar" MinWidth="15"/>
    <StackPanel Grid.Column="2" x:Name="EditControls" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="False">
     <ComboBox x:Name="FitBox" Width="91" SelectedIndex="0" SelectionChanged="FitChanged" Foreground="#14213A" VerticalContentAlignment="Center">
      <ComboBoxItem Content="전체 맞춤"/><ComboBoxItem Content="가로 맞춤"/><ComboBoxItem Content="세로 맞춤"/><ComboBoxItem Content="실제 크기"/><ComboBoxItem Content="수동 배율"/>
     </ComboBox>
     <Button Content="−" Padding="7,4" Click="ZoomOutClick"/>
     <TextBox x:Name="ZoomBox" Text="100" Width="48" VerticalContentAlignment="Center" Foreground="#14213A" KeyDown="ZoomKeyDown" LostKeyboardFocus="ZoomLostFocus" ToolTip="배율 % 입력 후 Enter (5~1600)"/>
     <TextBlock Text="%" Margin="3,0"/>
     <Button Content="+" Padding="7,4" Click="ZoomInClick"/>
     <Button Content="중앙" Padding="7,4" Click="CenterClick"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="2" Background="#1E2E49" MouseLeftButtonDown="DragBar">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="StatusLabel" Text="열기로 이미지를 선택하세요 · 본문 클릭 통과" Margin="10,0" TextTrimming="CharacterEllipsis" ToolTip="상단 빈 영역을 드래그하면 창 이동"/>
    <Button Grid.Column="1" Content="도움말" FontSize="11" Padding="6,1" Margin="2,3,8,3" Click="HelpClick"/>
   </Grid>
  </Grid>
 </Border>
</Window>
